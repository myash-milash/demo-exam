<Window x:Class="DemoWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoWpf"
        mc:Ignorable="d"
        Title="Авторизация" Height="420" Width="360">
    <Grid>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="60,25,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" Margin="131,29,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="130"/>

        <Label Content="Пароль" HorizontalAlignment="Left" Margin="60,56,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" Margin="131,60,0,0" VerticalAlignment="Top" Width="130"/>

        <UniformGrid Rows="2" Columns="2" Width="180" Height="180" Margin="0,105,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Image x:Name="Img0" Stretch="Fill" MouseDown="PuzzlePiece_Click" Margin="1"/>
            <Image x:Name="Img1" Stretch="Fill" MouseDown="PuzzlePiece_Click" Margin="1"/>
            <Image x:Name="Img2" Stretch="Fill" MouseDown="PuzzlePiece_Click" Margin="1"/>
            <Image x:Name="Img3" Stretch="Fill" MouseDown="PuzzlePiece_Click" Margin="1"/>
        </UniformGrid>

        <Button Content="Авторизоваться" HorizontalAlignment="Center" Margin="0,310,0,0" VerticalAlignment="Top" Width="130" Height="30" Click="Button_Click"/>
    </Grid>
</Window>
