<Window x:Class="DemoWpf.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoWpf"
        mc:Ignorable="d"
        Title="AdminWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="True" IsReadOnly="True"
                  SelectionChanged="UsersGrid_SelectionChanged"
                  HorizontalAlignment="Left" Width="340" Margin="0,0,0,10"/>

        <!-- Панель управления справа -->
        <StackPanel HorizontalAlignment="Left" Width="220" Margin="510,0,0,0">
            <TextBlock Text="Логин:" Margin="0,0,0,3"/>
            <TextBox x:Name="LoginBox" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,3"/>
            <TextBox x:Name="PasswordBox" Height="25" Margin="0,0,0,10"/>

            <CheckBox x:Name="IsAdminCheck" Content="Администратор (isAdmin)" Margin="0,5,0,10"/>
            <CheckBox x:Name="IsBlockedCheck" Content="Заблокирован (isBlocked)" Margin="0,0,0,15"/>

            <Button Content="Добавить пользователя" Click="AddButton_Click" Height="30" Margin="0,0,0,10"/>
            <Button Content="Сохранить изменения" Click="SaveButton_Click" Height="30"/>
        </StackPanel>

    </Grid>
</Window>
